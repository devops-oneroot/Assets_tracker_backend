# Copy to .env and fill in. The real .env is gitignored — never commit it.

# --- server ---
PORT=5050
CLIENT_ORIGIN=http://localhost:3000

# --- AWS DynamoDB ---
# The IAM user needs GetItem, PutItem, DeleteItem, Query and Scan on the table.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Partition key: entity (S), sort key: assetCode (S)
DYNAMODB_TABLE=Assets_v2
# Purchase orders. Optional - defaults to "<DYNAMODB_TABLE>-purchase-orders".
# Partition key "entity" (String), sort key "poNumber" (String).
DYNAMODB_PO_TABLE=PurchaseOrders
# Vendor master, shared across companies. Optional - defaults to
# "<DYNAMODB_TABLE>-vendors". Partition key "id" (String), no sort key.
DYNAMODB_VENDOR_TABLE=Vendors

# --- Cloudinary (photos, invoices, warranty documents) ---
CLOUD_NAME=
CLOUD_API_KEY=
CLOUD_API_SECRET=
CLOUD_FOLDER=accounts-dashboard/assets

# --- auth ---
# The single shared dashboard password.
APP_PASSWORD=
# Used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
SESSION_HOURS=12

# --- Purchase order email (Gmail / Google Workspace) ---
# "Send Email" on a purchase order goes out over the buying company's own
# mailbox. Each needs a Gmail app password (Google Account > Security > 2-Step
# Verification > App passwords) - the normal account password will not work.
# The address itself is fixed in code: onerootoffice@oneroot.farm for ENP,
# accounts@goldcoinsresort.in for GCC. Only the app password lives here.
SMTP_PASS_ENP=
SMTP_PASS_GCC=

# --- "Import from PDF" on the New PO form (optional) ---
# Reads a vendor quotation/invoice/old-PO PDF with Gemini and pre-fills the
# form. Get a free key at aistudio.google.com/apikey. Left blank, the feature
# just shows a clear setup error - nothing else in the app depends on it.
GEMINI_API_KEY=
# Optional - defaults to gemini-flash-lite-latest, and falls through to other
# models if that one is busy or out of free quota (the free tier counts its
# daily allowance per model, so the fallbacks multiply how many documents a
# day you can import). Set this only to pin a specific model.
GEMINI_MODEL=
