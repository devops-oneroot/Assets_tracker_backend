# dependencies
/node_modules

# build output
/dist
*.tsbuildinfo

# secrets — AWS keys, Cloudinary secret, app password, JWT secret.
# Commit .env.example instead; never the real file.
.env
.env.*
!.env.example

# credentials that must never be committed
*.pem
*.key
*.p12
*.pfx
aws.json
credentials

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/

# runtime / scratch
*.pid
*.seed
.cache/
tmp/
temp/

# generated documents that are not source
*.xlsx
*.pdf

# editor / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
